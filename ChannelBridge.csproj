<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChannelBridge</AssemblyName>
    <Version>1.2.0-experimental.2</Version>
    <FileVersion>1.2.0.2</FileVersion>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /><PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.6" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="English.tsv" /></ItemGroup>
</Project>
